AVASOC_ENV=production                 # "dev" allows an ephemeral secret and prints reset tokens to the log
AVASOC_SECRET=change-me-to-48-random-characters-minimum-32     # python -c "import secrets;print(secrets.token_urlsafe(48))"
AVASOC_DATA_DIR=./data                # sqlite db + retained audio live here
AVASOC_CORS_ORIGINS=http://localhost:3000
AVASOC_MAX_UPLOAD_MB=25
AVASOC_TOKEN_TTL_HOURS=12
AVASOC_DEFAULT_RETENTION_HOURS=24     # raw audio is deleted after this (per-user setting can lower it)
AVASOC_SIGNUP_OPEN=true
AVASOC_STT_MODEL=base                 # faster-whisper model size; downloaded on first use
